# Environment configuration for Command Center (api)
DD_API_KEY=YOUR-API-KEY # Needed for logs, APM, LLM Observability
DD_ENV=development
DD_SERVICE=command-center
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=command-center
DD_LLMOBS_AGENTLESS_ENABLED=1

# Frontend (Vite exposes VITE_* vars to the browser)
VITE_DD_CLIENT_TOKEN=YOUR-CLIENT-TOKEN # Needed for Browser Logs, RUM in the frontend
VITE_DD_APPLICATION_ID=YOUR-APPLICATION-ID # Needed for RUM in the frontend
VITE_DD_SITE=datadoghq.com
VITE_DD_SERVICE=command-center-frontend
VITE_DD_ENV=development
